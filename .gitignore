# Virtual environment
.venv/

# ChromaDB data (rebuilt by indexing)
data/chroma/

# Entity/observation/relation store (runtime state)
data/memory.db
data/memory.db-wal
data/memory.db-shm

# Legacy JSON store (kept as a frozen backup after SQLite migration)
data/memory_entities.json
data/memory_graph.json
data/vaults.json
data/*_calibration.json

# ONNX model (downloaded/exported by setup.bat)
data/embeddinggemma_onnx/

# Logs
data/server.log
daemon.log
daemon.log.*

# Vault export archives (user-generated)
data/exports/

# Cygwin/Git Bash crash dumps
*.stackdump

